<odoo>
    <record id="view_picking_form_redbox" model="ir.ui.view">
        <field name="name">stock.picking.form.redbox</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_redbox_label"
                        string="RedBox Label"
                        type="object"
                        invisible="not redbox_label_url"/>
                <button name="action_redbox_create_return"
                        string="Create RedBox Return"
                        type="object"
                        class="btn-primary"
                        invisible="not redbox_can_create_return"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <field name="redbox_delivery_type" invisible="1"/>
                <field name="redbox_can_create_return" invisible="1"/>
                <group string="RedBox Shipping" name="redbox_shipping"
                       invisible="not redbox_shipment_id and redbox_delivery_type != 'redbox'">
                    <group>
                        <field name="redbox_shipment_id"/>
                        <field name="redbox_reference"/>
                        <field name="redbox_shipment_status" readonly="1"/>
                        <field name="redbox_status_code" readonly="1"/>
                        <field name="redbox_status_date" readonly="1"/>
                    </group>
                    <group>
                        <field name="redbox_cod_amount" invisible="not redbox_cod_amount"/>
                        <field name="redbox_return_code" invisible="not redbox_return_code"/>
                        <field name="redbox_origin_picking_id" invisible="not redbox_origin_picking_id"/>
                        <field name="redbox_label_url" widget="url" readonly="1" invisible="not redbox_label_url"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
