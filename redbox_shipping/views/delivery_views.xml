<odoo>
    <record id="view_delivery_carrier_form_redbox" model="ir.ui.view">
        <field name="name">delivery.carrier.form.redbox</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group" position="inside">

                <group string="Redbox Configuration" invisible="delivery_type != 'redbox'">
                    <field name="redbox_api_key" password="True" required="delivery_type == 'redbox'"/>
                </group>

            </xpath>

        </field>
    </record>
</odoo>